<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BlogSpace - Home</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <nav class="navbar">

        <div class="logo">
            ✦ BlogSpace
        </div>

        <div class="nav-links">

            <a href="/" class="active">
                Home
            </a>

            <a href="#">
                Blogs
            </a>

            <a href="#">
                About
            </a>

            <a href="/logout" class="logout">
                Logout
            </a>

        </div>

    </nav>

    <section class="hero">

        <div class="hero-content">

            <span class="badge">
                ✨ Welcome to BlogSpace
            </span>

            <h1>
                Stories that
                <span>inspire.</span>
            </h1>

            <p>
                Discover interesting stories, ideas and
                experiences from our community of writers.
            </p>

            <button class="explore-btn">
                Explore Blogs →
            </button>

        </div>

    </section>

    <section class="welcome">

        <p>
            Welcome back,
            <strong><%= user %></strong> 👋
        </p>

    </section>

    <section class="blog-section">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    LATEST STORIES
                </span>

                <h2>
                    Featured Blogs
                </h2>

            </div>

            <a href="#">
                View all →
            </a>

        </div>


        <div class="blog-grid">

            <div class="blog-card">

                <div class="blog-image image-one">
                    🌄
                </div>

                <div class="blog-content">

                    <span class="category">
                        LIFESTYLE
                    </span>

                    <h3>
                        Finding Inspiration
                        in Everyday Life
                    </h3>

                    <p>
                        Sometimes the smallest moments
                        can create the biggest memories.
                    </p>

                    <div class="blog-footer">

                        <span>
                            👤 Admin
                        </span>

                        <span>
                            5 min read
                        </span>

                    </div>

                </div>

            </div>
            <div class="blog-card">

                <div class="blog-image image-two">
                    💻
                </div>

                <div class="blog-content">

                    <span class="category">
                        TECHNOLOGY
                    </span>

                    <h3>
                        The Future of
                        Web Development
                    </h3>

                    <p>
                        Explore modern technologies
                        changing the way we build websites.
                    </p>

                    <div class="blog-footer">

                        <span>
                            👤 Admin
                        </span>

                        <span>
                            7 min read
                        </span>

                    </div>

                </div>

            </div>
            <div class="blog-card">

                <div class="blog-image image-three">
                    🚀
                </div>

                <div class="blog-content">

                    <span class="category">
                        PRODUCTIVITY
                    </span>

                    <h3>
                        Build Better Habits
                        Every Day
                    </h3>

                    <p>
                        Small consistent actions can
                        help you achieve your biggest goals.
                    </p>

                    <div class="blog-footer">

                        <span>
                            👤 Admin
                        </span>

                        <span>
                            4 min read
                        </span>

                    </div>

                </div>

            </div>


        </div>

    </section>
    <footer>

        <div class="footer-logo">
            ✦ BlogSpace
        </div>

        <p>
            © 2026 BlogSpace. All rights reserved.
        </p>

    </footer>


</body>

</html>